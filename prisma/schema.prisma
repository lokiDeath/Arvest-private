// ============================================================
// Arvest Private Banking — Prisma schema (v2)
// PostgreSQL / Supabase (Vercel Marketplace integration)
//
// Financial core:
//   • ALL money movement goes through the double-entry ledger
//     (LedgerTransaction + LedgerEntry). Account balances are
//     ONLY mutated inside lib/ledger.ts postLedgerInTx().
//   • Account.balance is the book balance; available is the
//     spendable balance; held is the sum of pending holds.
//     Invariant: balance == available + held (enforced by ledger).
//   • Posted transactions are REVERSED (mirrored entries), never
//     deleted or silently edited.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  loginId       String?   @unique
  name          String
  passwordHash  String
  role          String    @default("CUSTOMER") // CUSTOMER | ADMIN
  status        String    @default("ACTIVE") // ACTIVE | FROZEN
  phone         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  bills          BillPay[]
  auditLogs      AuditLog[]
  resetCodes     ResetCode[]
  cards          Card[]
  notifications  Notification[]
  loans          Loan[]
  messages       Message[]
  appointments   Appointment[]
  alerts         Alert[]
  checkDeposits  CheckDeposit[]
  zelleTransfers ZelleTransfer[]
  wallets        Wallet[]
  approvals      Approval[]
  ledgerTxs      LedgerTransaction[]
  securityEvents SecurityEvent[]
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // CHECKING | SAVINGS | PRIVATE_CLIENT
  nickname      String
  accountNumber String   @unique
  routingNumber String   @default("082900883")
  balance       Float    @default(0) // book balance (available + held)
  available     Float    @default(0) // spendable
  held          Float    @default(0) // reserved by pending items
  currency      String   @default("USD")
  status        String   @default("ACTIVE") // ACTIVE | FROZEN | CLOSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries        LedgerEntry[]
  bills          BillPay[]
  cards          Card[]
  loans          Loan[]
  deposits       CheckDeposit[]
  alerts         Alert[]
  zelleTransfers ZelleTransfer[]
}

// ---------------- Ledger (double entry, immutable) ----------------

model LedgerTransaction {
  id           String    @id @default(cuid())
  reference    String    @unique // ARP-XXX-...
  type         String // TRANSFER | DEPOSIT | WITHDRAWAL | ZELLE | BILLPAY | LOAN_DISBURSEMENT | LOAN_PAYMENT | ADJUSTMENT | REVERSAL | FEE | INTEREST | HOLD | RELEASE
  category     String    @default("OTHER") // TRANSFER | DEPOSIT | WITHDRAWAL | PAYMENT | LOAN | ADJUSTMENT | ZELLE | FEE | INTEREST | OTHER
  userId       String? // originating customer (SetNull)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  description  String
  counterparty String?
  memo         String?
  status       String    @default("POSTED") // PENDING | POSTED | DECLINED | REVERSED | FLAGGED
  meta         String    @default("{}")
  reversalOfId String? // LedgerTransaction that this reversal mirrors
  postedAt     DateTime?
  createdAt    DateTime  @default(now())

  entries LedgerEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
}

model LedgerEntry {
  id              String            @id @default(cuid())
  ledgerTxId      String
  ledgerTx        LedgerTransaction @relation(fields: [ledgerTxId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  direction       String // DEBIT | CREDIT (from this account's perspective)
  amount          Float
  bucketFrom      String? // available | held | external — where funds left from
  bucketTo        String? // available | held | external — where funds arrived to
  balanceBefore   Float
  balanceAfter    Float
  availableBefore Float
  availableAfter  Float
  memo            String?
  createdAt       DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([ledgerTxId])
}

// ---------------- Operations queue ----------------

model Approval {
  id           String    @id @default(cuid())
  type         String // CHECK_DEPOSIT | EXTERNAL_TRANSFER | ZELLE | BILLPAY | LOAN | WALLET_SEND | ACCOUNT_OPENING
  reference    String    @unique
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount       Float     @default(0)
  payload      String    @default("{}") // JSON snapshot of the request
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy  String?
  decidedBy    String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([type, status])
}

// ---------------- Banking products ----------------

model Card {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  issuedBy       String   @default("ARVEST") // ARVEST | EXTERNAL
  cardType       String // DEBIT | CREDIT
  network        String // VISA | MASTERCARD | AMEX | DISCOVER
  cardholder     String
  cardNumberEnc  String   @default("") // AES-256-GCM encrypted PAN (never plaintext)
  cardLast4      String   @default("0000")
  expiryMonth    Int
  expiryYear     Int
  pinHash        String? // bcrypt — PIN is never recoverable
  color          String   @default("CRIMSON") // CRIMSON | GOLD | OBSIDIAN | PLATINUM | SAPPHIRE | EMERALD
  status         String   @default("ACTIVE") // ACTIVE | FROZEN | LOST | CLOSED
  creditLimit    Float    @default(0)
  creditUsed     Float    @default(0)
  dailyLimit     Float    @default(5000)
  // Billing address — only for EXTERNAL cards
  billingAddress String?
  billingCity    String?
  billingState   String?
  billingZip     String?
  billingCountry String   @default("USA")
  nickname       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Loan {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String? // disbursement/payment account
  account          Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  loanType         String // PERSONAL | AUTO | HOME | STUDENT
  amount           Float
  term             Int // months
  interestRate     Float     @default(7.9) // APR %
  monthlyPayment   Float     @default(0)
  remainingBalance Float     @default(0)
  status           String    @default("PENDING") // PENDING | ACTIVE | REJECTED | PAID_OFF | DEFAULT
  purpose          String?
  employer         String?
  annualIncome     Float?
  approvedBy       String?
  approvedAt       DateTime?
  decisionNote     String?
  ledgerTxId       String? // disbursement ledger transaction
  approvalId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payments LoanPayment[]
}

model LoanPayment {
  id         String   @id @default(cuid())
  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  accountId  String?
  amount     Float
  principal  Float
  interest   Float
  ledgerTxId String?
  status     String   @default("POSTED") // POSTED | REVERSED
  createdAt  DateTime @default(now())
}

model BillPay {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payee      String
  payeeAccount String?
  amount     Float
  memo       String?
  payDate    DateTime  @default(now())
  status     String    @default("SCHEDULED") // SCHEDULED | PROCESSING | PAID | ON_HOLD | CANCELLED | FAILED
  reference  String    @unique
  approvalId String?
  ledgerTxId String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, payDate])
}

model ZelleTransfer {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId  String
  account        Account   @relation(fields: [fromAccountId], references: [id], onDelete: Cascade)
  recipientName  String
  recipientEmail String?
  recipientPhone String?
  amount         Float
  memo           String?
  status         String    @default("PENDING") // PENDING | COMPLETED | ON_HOLD | DECLINED
  reference      String    @unique
  approvalId     String?
  ledgerTxId     String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  fromBank  Boolean  @default(false)
  read      Boolean  @default(false)
  replyToId String?
  createdAt DateTime @default(now())
}

model Appointment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // BRANCH | PHONE
  topic     String
  date      DateTime
  branchId  String?
  status    String   @default("SCHEDULED") // SCHEDULED | CONFIRMED | CANCELLED | COMPLETED
  notes     String?
  createdAt DateTime @default(now())
}

model CheckDeposit {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Float
  checkNumber String?
  frontImage  String?
  backImage   String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  memo        String?
  reference   String    @unique
  approvalId  String?
  ledgerTxId  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

// ---------------- Digital wallet (SANDBOX — clearly labeled, no blockchain) ----------------

model Wallet {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletType String // BTC | ETH | USDC | USD
  address    String   @unique // sandbox handle, not a real chain address
  balance    Float    @default(0)
  label      String?
  status     String   @default("ACTIVE") // ACTIVE | FROZEN | CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String // SEND | RECEIVE | FUND
  amount      Float
  currency    String
  counterparty String?
  sandboxRef  String? // internal sandbox reference — NOT a blockchain hash
  status      String   @default("PENDING") // PENDING | COMPLETED | DECLINED
  memo        String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ---------------- Alerts & notifications ----------------

model Alert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // BALANCE_BELOW | BALANCE_ABOVE | LARGE_TRANSACTION
  threshold   Float?
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enabled     Boolean   @default(true)
  lastState   Boolean   @default(false) // last evaluated condition state (dedupe)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id            String    @id @default(cuid())
  recipientRole String? // 'ADMIN' broadcast
  recipientId   String? // specific user
  userId        String? // subject user (for admin feed context)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          String
  title         String
  body          String
  read          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([recipientId, read, createdAt])
  @@index([recipientRole, read, createdAt])
}

// ---------------- Security & audit ----------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor     String
  action    String
  detail    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // LOGIN | LOGIN_FAILED | LOGOUT | PASSWORD_CHANGED | FROZEN_LOGIN | RATE_LIMITED
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model ResetCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String // stored hashed (bcrypt) — never plaintext
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Repeated-click protection: one row per client-generated key per
// endpoint. Insert acts as the lock; concurrent duplicates get a 409.
model IdempotencyKey {
  key       String   @id
  endpoint  String
  lockedAt  DateTime @default(now())
  response  String?
  statusCode Int?
  done      Boolean  @default(false)

  @@index([endpoint, lockedAt])
}
